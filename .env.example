# SEB — environment template (copy to .env, fill only what you have)
# Nothing here is required to run the offline pipeline.
# SEB runs in DRY-RUN / QUEUED mode when a key is absent — never fabricates calls.

# --- Stripe (invoicing, pay-later only; SEB never charges) ---
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Telegram escalation to Malik (SOUL.md §6) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# SEB_MALIK_CHAT_ID=987654321

# --- Attack engines (optional; import-guarded if absent) ---
# GARAK_API_KEY=
# PYRIT_ENDPOINT=

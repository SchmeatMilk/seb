# ── Output styling ──────────────────────────────────────────────────────────
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"


def _ok(txt): return f"{GREEN}{txt}{RESET}"
def _warn(txt): return f"{YELLOW}{txt}{RESET}"
def _fail(txt): return f"{RED}{txt}{RESET}"
def _info(txt): return f"{CYAN}{txt}{RESET}"


# ── Checks ───────────────────────────────────────────────────────────────────


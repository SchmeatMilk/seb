    ("/llms.txt", "LLM instructions file"),
    ("/llms-full.txt", "LLM full instructions"),
    ("/robots.txt", "Robots.txt (may reveal AI crawler rules)"),
]

AI_WIDGET_PATTERNS = [
    (r"intercom", "Intercom (AI-Chat)"),
    (r"drift\.com|dynamicgo", "Drift (AI-Chat)"),
    (r"tawk\.to|tawkto", "Tawk.to (Chat)"),
    (r"crisp\.chat|client\.crisp", "Crisp (Chat)"),
    (r"tidio|tidiochat", "Tidio (AI-Chat)"),

}

AI_SURFACES = [
    ("/.well-known/ai-plugin.json", "ChatGPT Plugin manifest"),
    ("/openapi.json", "OpenAPI spec"),
    ("/api/openapi.json", "OpenAPI spec (alt path)"),
    ("/mcp.json", "MCP (Model Context Protocol) config"),

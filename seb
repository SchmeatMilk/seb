# Thread pool for concurrent requests
MAX_WORKERS = 10
REQUEST_TIMEOUT = 10
SURFACE_TIMEOUT = 5


def fetch_url(url: str, timeout: int = REQUEST_TIMEOUT) -> tuple[Optional[int], Optional[dict], Optional[str]]:
    """GET a URL; returns (status_code, headers_dict, body_preview)."""
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "seb-scan/0.2 (security-assessment-tool; https://github.com/SchmeatMilk/seb)",
            "Accept": "text/html,application/json,*/*",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.status
            headers = dict(resp.headers)
            body = resp.read(5000).decode("utf-8", errors="replace")
            return status, headers, body
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), None
    except (urllib.error.URLError, socket.timeout, OSError) as e:
        return None, None, None


def fetch_url_surface(url: str) -> tuple[str, Optional[int], Optional[dict], Optional[str]]:
    """Wrapper for concurrent surface checking - returns (path, status, headers, body)."""
    status, headers, body = fetch_url(url, timeout=SURFACE_TIMEOUT)
    path = urllib.parse.urlparse(url).path
    return path, status, headers, body


def check_security_headers(headers: dict) -> list[dict]:
    """Score each known security header."""
    results = []
    if not headers:
        return [{"header": h["label"], "status": "fail", "detail": "No response headers", "score": 0}
                for h in SECURITY_HEADERS.values()]

    for header, spec in SECURITY_HEADERS.items():
        raw = headers.get(header.lower(), headers.get(header, ""))
        if not raw:
            results.append({"header": spec["label"], "status": "fail",
                            "detail": f"Missing — {spec['desc']}", "score": 0})
        elif spec["good"](raw):
            results.append({"header": spec["label"], "status": "pass",
                            "detail": raw[:80], "score": 10})
        elif spec["warn"](raw):
            results.append({"header": spec["label"], "status": "warn",
                            "detail": f"Weak — {raw[:80]}", "score": 5})
        else:
            results.append({"header": spec["label"], "status": "fail",
                            "detail": raw[:80], "score": 0})
    return results


def check_ai_surfaces(domain: str) -> list[dict]:
    """Probe common AI/LLM endpoint paths concurrently."""
    results = []
    
    # Build URLs
    urls = [f"https://{domain}{path}" for path, label in AI_SURFACES]
    
    # Concurrent fetch
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        future_to_path = {executor.submit(fetch_url_surface, url): url for url in urls}
        
        # Map path to label for results
        path_to_label = {path: label for path, label in AI_SURFACES}
        
        for future in as_completed(future_to_path):
            path, status, headers, body = future.result()
            label = path_to_label.get(path, "Unknown")
            
            if status and status < 400:
                results.append({"path": path, "label": label, "status": "found",
                                "status_code": status, "detail": (body or "")[:120]})
            elif status and status == 403:
                results.append({"path": path, "label": label, "status": "blocked",
                                "status_code": 403, "detail": "Access forbidden (403)"})
            else:
                results.append({"path": path, "label": label, "status": "not_found",
                                "status_code": status, "detail": ""})
    
    # Sort results by path for consistent output
    results.sort(key=lambda x: x["path"])
    return results


def check_ai_widgets(body: str) -> list[dict]:
    """Scan HTML for known AI/chat widget signatures."""
    results = []
    if not body:
        return results
    for pattern, label in AI_WIDGET_PATTERNS:
        if re.search(pattern, body, re.IGNORECASE):
            results.append({"widget": label, "status": "detected"})
    return results


def check_ssl(domain: str) -> dict:
    """Quick SSL/TLS check via socket."""
    try:
        ctx = ssl.create_default_context()
        with socket.create_connection((domain, 443), timeout=8) as sock:
            with ctx.wrap_socket(sock, server_hostname=domain) as ssock:
                cert = ssock.getpeercert()
                if not cert:
                    return {"status": "warn", "detail": "No certificate info", "score": 5}
                not_after = cert.get("notAfter", "")
                return {"status": "pass", "detail": f"Valid cert, expires {not_after}", "score": 10}
    except Exception as e:
        return {"status": "fail", "detail": str(e)[:100], "score": 0}


# ── DNS Security Checks ───────────────────────────────────────────────────────

def check_dns_security(domain: str) -> dict:
    """Check DNS security records (SPF, DMARC, DKIM)."""
    results = {
        "spf": {"status": "not_found", "detail": "", "score": 0},
        "dmarc": {"status": "not_found", "detail": "", "score": 0},
        "dkim": {"status": "not_found", "detail": "", "score": 0},
    }
    
    # Try dnspython first
    try:
        import dns.resolver
        import dns.exception
        
        resolver = dns.resolver.Resolver()
        resolver.timeout = 5
        resolver.lifetime = 5
        
        # Check SPF
        try:
            answers = resolver.resolve(domain, 'TXT')
            for rdata in answers:
                txt = rdata.to_text().strip('"')
                if "v=spf1" in txt:
                    results["spf"] = {"status": "found", "detail": txt, "score": 10}
                    break
        except dns.exception.DNSException:
            pass
        
        # Check DMARC
        try:
            answers = resolver.resolve(f"_dmarc.{domain}", 'TXT')
            for rdata in answers:
                txt = rdata.to_text().strip('"')
                if "v=DMARC1" in txt:
                    results["dmarc"] = {"status": "found", "detail": txt, "score": 10}
                    break
        except dns.exception.DNSException:
            pass
        
        # Check DKIM (common selectors)
        common_selectors = ["default", "google", "k1", "k2", "selector1", "selector2", "mail"]
        for selector in common_selectors:
            try:
                answers = resolver.resolve(f"{selector}._domainkey.{domain}", 'TXT')
                for rdata in answers:
                    txt = rdata.to_text().strip('"')
                    if "v=DKIM1" in txt:
                        results["dkim"] = {"status": "found", "detail": f"Selector: {selector}", "score": 10}
                        break
                if results["dkim"]["status"] == "found":
                    break
            except dns.exception.DNSException:
                continue
                
    except ImportError:
        # Fallback to dig if available
        import subprocess
        import shutil
        
        if not shutil.which("dig"):
            return results
            
        # Check SPF
        try:
            result = subprocess.run(
                ["dig", "+short", "TXT", domain],
                capture_output=True, text=True, timeout=5
            )
            for line in result.stdout.splitlines():
                if "v=spf1" in line:
                    results["spf"] = {"status": "found", "detail": line.strip(), "score": 10}
                    break
        except Exception:
            pass
        
        # Check DMARC
        try:
            result = subprocess.run(
                ["dig", "+short", "TXT", f"_dmarc.{domain}"],
                capture_output=True, text=True, timeout=5
            )
            for line in result.stdout.splitlines():
                if "v=DMARC1" in line:
                    results["dmarc"] = {"status": "found", "detail": line.strip(), "score": 10}
                    break
        except Exception:
            pass
        
        # Check DKIM (common selectors)
        common_selectors = ["default", "google", "k1", "k2", "selector1", "selector2", "mail"]
        for selector in common_selectors:
            try:
                result = subprocess.run(
                    ["dig", "+short", "TXT", f"{selector}._domainkey.{domain}"],
                    capture_output=True, text=True, timeout=3
                )
                if result.stdout.strip() and "v=DKIM1" in result.stdout:
                    results["dkim"] = {"status": "found", "detail": f"Selector: {selector}", "score": 10}
                    break
            except Exception:
                continue
    
    return results


# ── Scoring ──────────────────────────────────────────────────────────────────

# Updated scoring with more headers
HEADER_COUNT = 9  # 9 headers now (6 original + COOP + COEP + CORP)
HEADER_MAX = HEADER_COUNT * 10  # 90 max
SSL_MAX = 10
DNS_MAX = 30  # SPF + DMARC + DKIM = 30 max
AI_SURFACE_RISK = 20  # found surfaces increase risk score (inverted in final)
WIDGET_BONUS = 15     # detected AI widgets

MAX_SCORE = HEADER_MAX + SSL_MAX + DNS_MAX + WIDGET_BONUS  # 145 base; surfaces subtract


def compute_score(results: dict) -> dict:
    h_score = sum(r["score"] for r in results.get("headers", []))
    ssl_score = results.get("ssl", {}).get("score", 0)
    
    # DNS security scoring
    dns_score = sum(r.get("score", 0) for r in results.get("dns_security", {}).values())

    # AI surfaces found = higher attack surface = lower security score
    found_surfaces = [r for r in results.get("ai_surfaces", []) if r["status"] == "found"]
    surface_penalty = min(len(found_surfaces) * 3, AI_SURFACE_RISK)

    # AI widgets detected = more AI attack surface
    widget_count = len(results.get("ai_widgets", []))
    widget_bonus = min(widget_count * 2, WIDGET_BONUS)

    raw = h_score + ssl_score + dns_score + widget_bonus - surface_penalty
    final = max(0, min(100, raw))

    # Risk tier
    if final >= 70:
        tier = "Good"
    elif final >= 40:
        tier = "Moderate"
    else:
        tier = "High Risk"

    return {
        "score": final,
        "tier": tier,
        "breakdown": {
            "security_headers": f"{h_score}/{HEADER_MAX}",
            "ssl_tls": f"{ssl_score}/{SSL_MAX}",
            "dns_security": f"{dns_score}/{DNS_MAX}",
            "surface_penalty": f"-{surface_penalty}",
            "ai_widgets_detected": f"+{widget_bonus}",
            "total": f"{final}/100",
            "risk_tier": tier,
        },
    }



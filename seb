def print_header(domain: str, version: str):
    print(f"\n{BOLD}SEB — Secure Environment Basics{RESET} v{version}")
    print(f"{_info('Target:')} {domain}")
    print(f"{_info('Time:')}   {datetime.now(timezone.utc).isoformat()}")
    print()


def print_table(title: str, items: list, cols: list, status_fn):
    if not items:
        print(f"  {_warn('(none)')}")
        return
    for item in items:
        status = item.get("status", "?")
        label = item.get(cols[0], "?")
        detail = item.get(cols[1], "")
        print(f"  {status_fn(status)} {_info(label)} | {detail}")


def print_results(domain: str, results: dict):
    print_header(domain, __version__)

    # Security headers
    print(f"{BOLD}Security Headers:{RESET}")
    for h in results["headers"]:
        icon = {"pass": "✓", "warn": "⚡", "fail": "✗"}.get(h["status"], "?")
        color = {"pass": _ok, "warn": _warn, "fail": _fail}.get(h["status"], _info)
        print(f"  {color(icon)} {h['header']:20s} {color(h['detail'][:70])}")

    # SSL
    print(f"\n{BOLD}SSL/TLS:{RESET}")
    s = results["ssl"]
    icon = {"pass": "✓", "warn": "⚡", "fail": "✗"}.get(s["status"], "?")
    color = {"pass": _ok, "warn": _warn, "fail": _fail}.get(s["status"], _info)
    print(f"  {color(icon)} {color(s['detail'][:90])}")

    # DNS Security
    print(f"\n{BOLD}DNS Security:{RESET}")
    for key in ["spf", "dmarc", "dkim"]:
        dns = results["dns_security"].get(key, {})
        icon = {"found": "✓", "not_found": "✗"}.get(dns.get("status", "not_found"), "?")
        color = {"found": _ok, "not_found": _fail}.get(dns.get("status", "not_found"), _info)
        label = key.upper()
        detail = dns.get("detail", "Missing")
        print(f"  {color(icon)} {label:20s} {color(detail[:70])}")

    # AI surfaces
    print(f"\n{BOLD}AI / LLM Surfaces:{RESET}")
    found = [r for r in results["ai_surfaces"] if r["status"] == "found"]
    blocked = [r for r in results["ai_surfaces"] if r["status"] == "blocked"]
    if found:
        for r in found:
            print(f"  {_fail('⚠')} {r['path']:40s} {r['detail'][:70]}")
    if blocked:
        for r in blocked:
            print(f"  {_warn('⊘')} {r['path']:40s} Blocked (403)")
    not_found_count = sum(1 for r in results["ai_surfaces"] if r["status"] == "not_found")
    print(f"  {_ok(f'{not_found_count} paths returned 404/other (expected for non-AI sites)')}")

    # AI widgets
    print(f"\n{BOLD}AI / Chat Widgets Detected:{RESET}")
    if results["ai_widgets"]:
        for w in results["ai_widgets"]:
            print(f"  {_warn('◆')} {w['widget']}")
    else:
        print(f"  {_ok('✓ None detected')}")

    # Score
    print(f"\n{BOLD}{'='*50}{RESET}")
    score = results["score"]
    tier = results.get("score_breakdown", {}).get("tier", "Unknown")
    if score >= 70:
        score_color = _ok
    elif score >= 40:
        score_color = _warn
    else:
        score_color = _fail
    print(f"  {BOLD}Risk Score:{RESET}  {score_color(f'{score}/100')}  {BOLD}Tier:{RESET} {score_color(tier)}")
    for k, v in results["score_breakdown"]["breakdown"].items():
        print(f"    {k:25s} {v}")
    print()


def print_json(results: dict):
    print(json.dumps(results, indent=2, default=str))


# ── Main ─────────────────────────────────────────────────────────────────────

def scan(domain: str, quick: bool = False) -> dict:
    """Run the full scan pipeline against a domain."""
    domain = domain.strip().lower()
    if domain.startswith("http://") or domain.startswith("https://"):
        domain = domain.split("://", 1)[1].split("/")[0]

    # Fetch homepage
    url = f"https://{domain}"
    status, headers, body = fetch_url(url)

    results = {
        "target": domain,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "scanner": f"seb v{__version__}",
        "headers": check_security_headers(headers) if headers else [],
        "ssl": check_ssl(domain),
        "dns_security": check_dns_security(domain),
        "ai_surfaces": check_ai_surfaces(domain) if not quick else [],
        "ai_widgets": check_ai_widgets(body) if body else [],
        "homepage_status": status,
    }

    score = compute_score(results)
    results["score"] = score["score"]
    results["score_breakdown"] = score

    return results


def main():
    parser = argparse.ArgumentParser(
        prog="seb",
        description="Secure Environment Basics — AI-domain risk scanner",
    )
    parser.add_argument("action", choices=["scan"], help="Action to perform")
    parser.add_argument("target", help="Domain to scan (e.g. example.com)")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    parser.add_argument("--quick", action="store_true",
                        help="Skip AI surface discovery (headers + SSL only)")
    parser.add_argument("--version", action="version", version=f"seb {__version__}")

    args = parser.parse_args()

    if args.action == "scan":
        results = scan(args.target, quick=args.quick)
        if args.json:
            print_json(results)
        else:
            print_results(args.target, results)


if __name__ == "__main__":
    main()